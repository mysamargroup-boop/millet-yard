    });
  }
}

// Route handler for order-status
async function handleOrderStatus(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  try {
    const url = new URL(request.url);
    let orderId = url.searchParams.get('order_id') || url.searchParams.get('orderId');
    let customerPhone = url.searchParams.get('phone') || url.searchParams.get('customer_phone');

    if (request.method === 'POST') {
      const body = await request.json();
      orderId = (body && (body.orderId || body.order_id)) || null;
      customerPhone = body.phone || body.customer_phone || null;
    }

    if (!orderId) {
      return new Response(
        JSON.stringify({ error: 'Missing query param: order_id' }),
        {
          status: 400,
          headers: {
            'Content-Type': 'application/json',
            ...getCORSHeaders(env, request),
          },
        },
      );
    }

    const supabase = createSupabaseAdmin(env);

    // 1. Fetch order from database (always)
    const { data: dbOrder, error: dbError } = await supabase
      .from('orders')
      .select(`
        *,
        order_items (
          *,
          customer_uploaded_images
        )
      `)
      .eq('external_order_id', orderId)
      .maybeSingle();

    // 2. If phone provided, verify it matches order (for guest upload viewing)
    if (customerPhone && dbOrder) {
      const normalizedInputPhone = String(customerPhone).replace(/\D/g, '').slice(-10);
      const normalizedOrderPhone = String(dbOrder.customer_phone).replace(/\D/g, '').slice(-10);

      if (normalizedInputPhone !== normalizedOrderPhone) {
        return new Response(
          JSON.stringify({ error: 'Phone number does not match order' }),
          {
            status: 403,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            },
          },
        );
      }
    }

    // 3. Fetch payment status from Cashfree
    const envType = env.CASHFREE_ENV?.trim().toUpperCase() || 'SANDBOX';
    const baseUrl = envType === 'PRODUCTION' ? 'https://api.cashfree.com/pg' : 'https://sandbox.cashfree.com/pg';
    const appId = env.CASHFREE_APP_ID?.trim();
    const secretKey = env.CASHFREE_SECRET_KEY?.trim();

    let cashfreeData = null;
    if (appId && secretKey) {
      try {
        const response = await fetch(`${baseUrl}/orders/${orderId}`, {
          method: 'GET',
          headers: {
            'x-api-version': '2023-08-01',
            'x-client-id': appId,
            'x-client-secret': secretKey,
          },
        });
        if (response.ok) {
          cashfreeData = await response.json();
        }
      } catch (e) {
        console.error('Cashfree fetch error:', e);
      }
    }

    // 4. Build response (hide sensitive data unless phone verified)
    const includeUploads = !!customerPhone; // Only include uploads if phone verified

    const result = {
      order_id: orderId,
      order_status: cashfreeData?.order_status || dbOrder?.status || 'UNKNOWN',
      payment_status: dbOrder?.payment_status || 'PENDING',
      payment_session_id: cashfreeData?.payment_session_id || null,
      payments_url: cashfreeData?.payments?.url || null,

      // DB order details
      customer_name: dbOrder?.customer_name,
      total_amount: dbOrder?.total_amount,
      created_at: dbOrder?.created_at,

      // Items (include uploads only if phone verified)
      items: includeUploads ? (dbOrder?.order_items || []) : (dbOrder?.order_items || []).map(item => ({
        ...item,
        customer_uploaded_images: undefined // Hide uploads without phone
      })),

      // Status display message
      status_message: getOrderStatusMessage(cashfreeData?.order_status || dbOrder?.status),
    };

    return new Response(JSON.stringify(result), {
      status: 200,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(env, request),
      },
    });
  } catch (error) {
    const message =
      error && typeof error === 'object' && 'message' in error
        ? String(error.message)
        : 'Unknown error';

    return new Response(
      JSON.stringify({
        error: `Failed to fetch order status: ${message}`,
      }),
      {
        status: 500,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      },
    );
  }
}

// Helper function for order status messages
function getOrderStatusMessage(status) {
  const messages = {
    'PENDING': 'Payment pending. Please complete your payment.',
    'ACTIVE': 'Payment pending. Please complete your payment.',
    'PAID': 'Payment successful! Your order has been confirmed.',
    'CONFIRMED': 'Payment successful! Your order has been confirmed.',
    'PROCESSING': 'Your order is being processed.',
    'SHIPPED': 'Your order has been shipped!',
    'DELIVERED': 'Your order has been delivered.',
    'CANCELLED': 'This order has been cancelled.',
    'RETURNED': 'Return has been processed.',
    'REFUNDED': 'Refund has been processed.',
  };
  return messages[status] || 'Order status: ' + (status || 'Unknown');
}

// Route handler for reviews
async function handleReviews(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  try {
    const supabase = createSupabaseAdmin(env);
    const url = new URL(request.url);
    const productId = url.searchParams.get('product_id');

    if (request.method === 'GET') {
      let query = supabase.from('reviews').select('*');

      if (productId) {
        query = query.eq('product_id', productId);
      }

      const { data, error } = await query.order('created_at', { ascending: false });

      if (error) throw error;

      return new Response(JSON.stringify(data || []), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    if (request.method === 'POST') {
      const reviewData = await request.json();

      const { data, error } = await supabase
        .from('reviews')
        .insert({
          product_id: reviewData.product_id,
          rating: reviewData.rating,
          comment: reviewData.comment,
          customer_name: reviewData.customer_name,
          is_approved: false,
        })
        .select()
        .single();

      if (error) throw error;

      return new Response(JSON.stringify(data), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    if (request.method === 'PUT') {
      const reviewData = await request.json();
      const { reviewId, isApproved } = reviewData;

      const { data, error } = await supabase
        .from('reviews')
        .update({
          is_approved: isApproved,
          updated_at: new Date().toISOString()
        })
        .eq('id', reviewId)
        .select()
        .single();

      if (error) throw error;

      return new Response(JSON.stringify(data), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    return new Response(
      JSON.stringify({ error: 'Method not allowed' }),
      {
        status: 405,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      },
    );
  } catch (error) {
    const message =
      error && typeof error === 'object' && 'message' in error
        ? String(error.message)
        : 'Unexpected error';

    return new Response(JSON.stringify({ error: message }), {
      status: 500,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(env, request),
      },
    });
  }
}

// Route handler for site images
async function handleSiteImages(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  try {
    const supabase = createSupabaseAdmin(env);

    if (request.method === 'GET') {
      const { data, error } = await supabase
        .from('site_images')
        .select('*')
        .order('id');

      if (error) throw error;

      // Transform snake_case to camelCase for frontend compatibility
      const transformedData = (data || []).map(img => ({
        id: img.id,
        key: img.key,
        name: img.name,
        imageUrl: img.image_url || null,
        imageHint: img.image_hint || '',
        linkUrl: img.link_url || null,
        type: img.type || 'image',
        createdAt: img.created_at,
        updatedAt: img.updated_at,
      }));

      return new Response(JSON.stringify(transformedData), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    if (request.method === 'POST') {
      const imageData = await request.json();

      const { data, error } = await supabase
        .from('site_images')
        .update({
          image_url: imageData.imageUrl,
          image_hint: imageData.imageHint,
          updated_at: new Date().toISOString()
        })
        .eq('id', imageData.id)
        .select()
        .single();

      if (error) throw error;

      return new Response(JSON.stringify(data), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    return new Response(
      JSON.stringify({ error: 'Method not allowed' }),
      {
        status: 405,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      },
    );
  } catch (error) {
    const message =
      error && typeof error === 'object' && 'message' in error
        ? String(error.message)
        : 'Unexpected error';

    return new Response(JSON.stringify({ error: message }), {
      status: 500,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(env, request),
      },
    });
  }
}

