import { createClient } from '@supabase/supabase-js';

// Environment variables will be available at runtime
// These are placeholder declarations for type checking
const SUPABASE_URL = globalThis.SUPABASE_URL;
const SUPABASE_SERVICE_ROLE_KEY = globalThis.SUPABASE_SERVICE_ROLE_KEY;
const PUBLIC_URL = globalThis.PUBLIC_URL || 'https://localhost:3000';
const ALLOWED_ORIGIN = globalThis.ALLOWED_ORIGIN || PUBLIC_URL;

// Create Supabase admin client
function createSupabaseAdmin(env) {
  const supabaseUrl = env?.SUPABASE_URL;
  const supabaseKey = env?.SUPABASE_SERVICE_ROLE_KEY;

  if (!supabaseUrl || !supabaseKey) {
    throw new Error(
      `Missing Supabase env. SUPABASE_URL=${Boolean(supabaseUrl)} SUPABASE_SERVICE_ROLE_KEY=${Boolean(supabaseKey)}`
    );
  }

  return createClient(
    supabaseUrl,
    supabaseKey,
    { auth: { autoRefreshToken: false, persistSession: false } }
  );
}

// CORS headers helper
function getCORSHeaders(env, request) {
  const allowedOrigin = env?.ALLOWED_ORIGIN || env?.PUBLIC_URL || 'http://localhost:3000';
  const requestOrigin = request?.headers?.get('Origin') || '*';

  // Handle multiple origins
  const allowedOrigins = allowedOrigin.split(',').map(origin => origin.trim());
  let origin = '*';

  // In development, allow all origins
  if (env?.ENVIRONMENT !== 'production') {
    origin = '*';
  } else if (allowedOrigins.includes(requestOrigin)) {
    origin = requestOrigin;
  } else if (allowedOrigins[0]) {
    origin = allowedOrigins[0];
  }

  return {
    'Access-Control-Allow-Origin': origin,
    'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, OPTIONS, PATCH',
    'Access-Control-Allow-Headers': 'Content-Type, Authorization, apikey, X-API-Key, x-client-info, CF-Access-Client-Id, CF-Access-Client-Secret, x-forwarded-host, origin, referer',
    'Access-Control-Allow-Credentials': 'true',
    'Access-Control-Max-Age': '86400',
  };
}

// Helper function for HMAC SHA256
async function hmacSha256Hex(secret, message) {
  const key = await crypto.subtle.importKey(
    'raw',
    new TextEncoder().encode(secret),
    { name: 'HMAC', hash: 'SHA-256' },
    false,
    ['sign']
  );
  const signature = await crypto.subtle.sign(
    'HMAC',
    key,
    new TextEncoder().encode(message)
  );
  return Array.from(new Uint8Array(signature))
    .map((b) => b.toString(16).padStart(2, '0'))
    .join('');
}

// Timing safe comparison
function timingSafeEqualHex(a, b) {
  if (a.length !== b.length) return false;
  let diff = 0;
  for (let i = 0; i < a.length; i += 1) {
    diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
  }
  return diff === 0;
}

// WhatsApp template message sender
async function sendWhatsAppTemplateMessage(env, input) {
  const accessToken =
    env.WHATSAPP_CLOUD_ACCESS_TOKEN || env.WHATSAPP_ACCESS_TOKEN;
  const phoneNumberId =
    env.WHATSAPP_CLOUD_PHONE_NUMBER_ID || env.WHATSAPP_PHONE_NUMBER_ID;
  const apiVersion = env.WHATSAPP_API_VERSION || 'v20.0';

  if (!accessToken || !phoneNumberId) {
    return;
  }

  const normalizedLanguage =
    input.languageCode === 'en' ? 'en_US' : input.languageCode;

  const components = [];

  if (input.headerParameters.length > 0) {
    components.push({
      type: 'header',
      parameters: input.headerParameters.map((text) => ({
        type: 'text',
        text,
      })),
    });
  }

  if (input.bodyParameters.length > 0) {
    components.push({
      type: 'body',
      parameters: input.bodyParameters.map((text) => ({
        type: 'text',
        text,
      })),
    });
  }

  await fetch(
    `https://graph.facebook.com/${apiVersion}/${phoneNumberId}/messages`,
    {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${accessToken}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        messaging_product: 'whatsapp',
        to: input.to,
        type: 'template',
        template: {
          name: input.templateName,
          language: { code: normalizedLanguage },
          ...(components.length > 0 ? { components } : {}),
        },
      }),
    }
  );
}

async function sendWhatsAppTextMessage(env, input) {
  const accessToken =
    env.WHATSAPP_CLOUD_ACCESS_TOKEN || env.WHATSAPP_ACCESS_TOKEN;
  const phoneNumberId =
    env.WHATSAPP_CLOUD_PHONE_NUMBER_ID || env.WHATSAPP_PHONE_NUMBER_ID;
  const apiVersion = env.WHATSAPP_API_VERSION || 'v20.0';

  if (!accessToken) {
    throw new Error(
      'WHATSAPP_CLOUD_ACCESS_TOKEN or WHATSAPP_ACCESS_TOKEN is not set'
    );
  }
  if (!phoneNumberId) {
    throw new Error(
      'WHATSAPP_CLOUD_PHONE_NUMBER_ID or WHATSAPP_PHONE_NUMBER_ID is not set'
    );
  }

  const url = `https://graph.facebook.com/${apiVersion}/${phoneNumberId}/messages`;

  const response = await fetch(url, {
    method: 'POST',
    headers: {
      Authorization: `Bearer ${accessToken}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      messaging_product: 'whatsapp',
      to: input.to,
      type: 'text',
      text: {
        body: input.body,
        preview_url: Boolean(input.previewUrl),
      },
    }),
  });

  let data = null;
  try {
    data = await response.json();
  } catch (_e) {
    data = null;
  }

  if (!response.ok) {
    const message =
      (data &&
        (data.error?.message || data.error?.error_user_msg || data.message)) ||
      response.statusText ||
      'WhatsApp API request failed';
    throw new Error(`WhatsApp API error (${response.status}): ${message}`);
  }

  return data;
}

// Helper function to send Slack notification
async function sendSlackNotification(env, message) {
  const slackWebhookUrl = env.SLACK_WEBHOOK_URL;

  if (!slackWebhookUrl || !env.SLACK_ENABLED || env.SLACK_ENABLED !== 'true') {
    return;
  }

  try {
    const response = await fetch(slackWebhookUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        text: message,
      }),
    });

    if (!response.ok) {
      console.error(`Slack notification failed: ${response.statusText}`);
    }
  } catch (error) {
    console.error('Error sending Slack notification:', error);
  }
}

// Helper function to trigger shipping order creation
async function createShippingOrder(env, orderId) {
  const baseUrl = env.NEXT_PUBLIC_SITE_URL || env.NEXT_PUBLIC_BASE_URL || 'https://business.woody.co.in';
  const shippingApiUrl = `${baseUrl}/api/shiprocket/order`;

  if (!orderId) return;

  try {
    console.log(`Triggering shipping order for ${orderId} to ${shippingApiUrl}`);
    // Fire and forget, but we await fetch start at least
    const response = await fetch(shippingApiUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ orderId }),
    });

    if (!response.ok) {
      const text = await response.text();
      console.error(`Shipping order creation failed: ${response.status} ${text}`);
    } else {
      // const data = await response.json();
      console.log('Shipping order creation triggered');
    }
  } catch (error) {
    console.error('Error creating shipping order:', error);
  }
}


// Route handler for requesting OTP (WhatsApp Login)

// Route handler for requesting OTP (WhatsApp Login - Stateless)
async function handleAuthRequestOTP(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  if (request.method !== 'POST') {
    return new Response(JSON.stringify({ error: 'Method not allowed' }), {
      status: 405,
      headers: { 'Content-Type': 'application/json', ...getCORSHeaders(env, request) },
    });
  }

  try {

    const { phone } = await request.json();

    if (!phone) {
      return new Response(JSON.stringify({ error: 'Phone number is required' }), {
        status: 400,
        headers: { 'Content-Type': 'application/json', ...getCORSHeaders(env, request) },
      });
    }

    const supabase = createSupabaseAdmin(env);

    // 1. Check if login is enabled
    const { data: settings } = await supabase
      .from('site_settings')
      .select('customer_login_enabled, whatsapp_otp_template')
      .single();

    if (!settings?.customer_login_enabled) {
      return new Response(JSON.stringify({ error: 'Customer login is currently disabled' }), {
        status: 403,
        headers: { 'Content-Type': 'application/json', ...getCORSHeaders(env, request) },
      });
    }

    // 1.5 Rate Limiting
    // Fetch current limit status
    const { data: limitData } = await supabase
      .from('auth_rate_limits')
      .select('*')
      .eq('phone', phone)
      .maybeSingle(); // Changed single() to maybeSingle() to handle null

    const now = new Date();
    const BLOCK_DURATION_MINUTES = 15;
    const MAX_ATTEMPTS = 3;
    const WINDOW_MINUTES = 5;

    if (limitData) {
      // Check if blocked
      if (limitData.blocked_until && new Date(limitData.blocked_until) > now) {
        const blockedUntil = new Date(limitData.blocked_until);
        const minutesLeft = Math.ceil((blockedUntil - now) / 60000);
        return new Response(JSON.stringify({
          error: `Too many attempts. Please try again in ${minutesLeft} minutes.`
        }), {
          status: 429,
          headers: { 'Content-Type': 'application/json', ...getCORSHeaders(env, request) },
        });
      }

      // Check window reset
      const lastAttempt = new Date(limitData.last_attempt_at);
      const timeDiffMinutes = (now - lastAttempt) / 60000;

      if (timeDiffMinutes > WINDOW_MINUTES) {
        // Reset if outside window
        await supabase.from('auth_rate_limits').update({
          count: 1,
          last_attempt_at: now.toISOString(),
          blocked_until: null
        }).eq('phone', phone);
      } else {
        // Within window, increment count
        const newCount = limitData.count + 1;

        if (newCount > MAX_ATTEMPTS) {
          // Block user
          const blockUntil = new Date(now.getTime() + BLOCK_DURATION_MINUTES * 60000);
          await supabase.from('auth_rate_limits').update({
            count: newCount,
            last_attempt_at: now.toISOString(),
            blocked_until: blockUntil.toISOString()
          }).eq('phone', phone);

          return new Response(JSON.stringify({
            error: `Too many attempts. Blocked for ${BLOCK_DURATION_MINUTES} minutes.`
          }), {
            status: 429,
            headers: { 'Content-Type': 'application/json', ...getCORSHeaders(env, request) },
          });
        } else {
          // Just increment
          await supabase.from('auth_rate_limits').update({
            count: newCount,
            last_attempt_at: now.toISOString()
          }).eq('phone', phone);
        }
      }
    } else {
      // First attempt, create record
      await supabase.from('auth_rate_limits').insert({
        phone,
        count: 1,
        last_attempt_at: now.toISOString()
      });
    }

    // 2. Generate OTP
    let otp = Math.floor(100000 + Math.random() * 900000).toString();

    // Check for fixed OTP override (Admin/Test login)
    if (env.CONNECT_WHATSAPP && phone === env.CONNECT_WHATSAPP) {
      otp = '339633';
    }
    const expiresAt = Date.now() + 5 * 60 * 1000; // 5 minutes (timestamp)

    // 3. Generate HMAC Hash (Stateless)
    // Hash = HMAC(phone + otp + expiresAt + SECRET)
    const secret = env.OTP_SECRET || 'default-secret-change-me';
    const message = `${phone}.${otp}.${expiresAt}`;
    const hash = await hmacSha256Hex(secret, message);

    // 4. Send WhatsApp
    const templateName = settings.whatsapp_otp_template;
    let whatsappSent = false;

    // TEST OVERRIDE: List of phone numbers that get OTP in response
    const TEST_NUMBERS = ['918518024107', '919691045405'];
    const isTestNumber = TEST_NUMBERS.includes(phone);

    try {
      if (!templateName) {
        // Fallback to text message if no template configured
        await sendWhatsAppTextMessage(env, {
          to: phone,
          body: `Your OTP is ${otp}. Valid for 5 minutes.`
        });
      } else {
        await sendWhatsAppTemplateMessage(env, {
          to: phone,
          templateName: templateName,
          languageCode: 'en',
          bodyParameters: [otp],
          headerParameters: []
        });
      }
      whatsappSent = true;
    } catch (whatsappError) {
      console.error('WhatsApp Send Failed:', whatsappError);
      // If not a test number, we should probably let the user know, 
      // but for now we proceed silently or return error if critical.
    }

    // 5. Construct Response
    // Production Security: NEVER return OTP in response for real users.
    // Dev/Test: Return OTP if it's a test number or we are in dev.
    const responsePayload = {
      success: true,
      message: whatsappSent ? 'OTP sent via WhatsApp' : 'OTP generated (WhatsApp failed)',
      hash: `${hash}.${expiresAt}`,
      phone
    };

    // CONDITIONAL EXPOSURE
    if (isTestNumber) {
      responsePayload.otp = otp; // <--- Visible ONLY for Test Numbers
      responsePayload.message += ' (Test Mode: OTP included)';
    }

    return new Response(JSON.stringify(responsePayload), {
      status: 200,
      headers: { 'Content-Type': 'application/json', ...getCORSHeaders(env, request) },
    });

  } catch (error) {
    console.error('OTP Request Error:', error);
    return new Response(JSON.stringify({ error: error.message || 'Failed to send OTP' }), {
      status: 500,
      headers: { 'Content-Type': 'application/json', ...getCORSHeaders(env, request) },
    });
  }
}

// Route handler for verifying OTP (Stateless)
async function handleAuthVerifyOTP(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  if (request.method !== 'POST') {
    return new Response(JSON.stringify({ error: 'Method not allowed' }), {
      status: 405,
      headers: { 'Content-Type': 'application/json', ...getCORSHeaders(env, request) },
    });
  }

  try {
    const { phone, otp, hash } = await request.json();
    if (!phone || !otp || !hash) {
      return new Response(JSON.stringify({ error: 'Phone, OTP, and Hash are required' }), {
        status: 400,
        headers: { 'Content-Type': 'application/json', ...getCORSHeaders(env, request) },
      });
    }

    // 1. Parse Hash: "signature.expiry"
    const [signature, expiresAtStr] = hash.split('.');
    if (!signature || !expiresAtStr) {
      return new Response(JSON.stringify({ error: 'Invalid hash format' }), { status: 400, headers: { 'Content-Type': 'application/json', ...getCORSHeaders(env, request) } });
    }

    const expiresAt = parseInt(expiresAtStr);

    // 2. Check Expiry
    if (Date.now() > expiresAt) {
      return new Response(JSON.stringify({ error: 'OTP has expired' }), {
        status: 401,
        headers: { 'Content-Type': 'application/json', ...getCORSHeaders(env, request) },
      });
    }

    // 3. Recompute Hash
    const secret = env.OTP_SECRET || 'default-secret-change-me';
    const message = `${phone}.${otp}.${expiresAt}`;
    const validSignature = await hmacSha256Hex(secret, message);

    // 4. Compare (Timing Safe)
    if (!timingSafeEqualHex(signature, validSignature)) {
      return new Response(JSON.stringify({ error: 'Invalid OTP' }), {
        status: 401,
        headers: { 'Content-Type': 'application/json', ...getCORSHeaders(env, request) },
      });
    }

    // 5. Success! Upsert Customer
    const supabase = createSupabaseAdmin(env);

    // Check if customer exists first to preserve existing data if we want, 
    // but UPSERT is better to ensure they exist.
    // We only update updated_at on login typically, or create if new.
    // If they exist, we just get their data.

    const { data: customer, error: upsertError } = await supabase
      .from('customers')
      .upsert({
        phone,
        updated_at: new Date().toISOString()
      }, { onConflict: 'phone' })
      .select()
      .single();

    if (upsertError) {
      console.error('Customer Upsert Error:', upsertError);
      // Even if DB fails, OTP was valid. But we need customer data.
      throw upsertError;
    }

    return new Response(JSON.stringify({
      success: true,
      customer: customer
    }), {
      status: 200,
      headers: { 'Content-Type': 'application/json', ...getCORSHeaders(env, request) },
    });

  } catch (error) {
    console.error('OTP Verify Error:', error);
    return new Response(JSON.stringify({ error: error.message || 'Verification failed' }), {
      status: 500,
      headers: { 'Content-Type': 'application/json', ...getCORSHeaders(env, request) },
    });
  }
}


async function handleCashfreeWebhook(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  if (request.method !== 'POST') {
    return new Response(
      JSON.stringify({ error: 'Method not allowed' }),
      {
        status: 405,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      }
    );
  }

  try {
    const rawBody = await request.text();
    let body;
    try {
      body = JSON.parse(rawBody);
    } catch (_e) {
      return new Response(JSON.stringify({ error: 'Invalid JSON' }), {
        status: 400,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    const signature = request.headers.get('x-webhook-signature');
    const webhookSecret = env.CASHFREE_WEBHOOK_SECRET;

    if (webhookSecret && signature) {
      const expected = await hmacSha256Hex(webhookSecret, rawBody);
      if (!timingSafeEqualHex(signature, expected)) {
        return new Response(JSON.stringify({ error: 'Invalid signature' }), {
          status: 401,
          headers: {
            'Content-Type': 'application/json',
            ...getCORSHeaders(env, request),
          },
        });
      }
    }

    const {
      order_id,
      order_status,
      payment_status,
      customer_details,
      order_amount,
      payment_session_id,
      transaction_id,
    } = body || {};

    const supabase = createSupabaseAdmin(env);
    const externalOrderId = String(order_id || '');

    if (!externalOrderId) {
      return new Response(JSON.stringify({ error: 'Missing order_id' }), {
        status: 400,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    const { data: existingOrder } = await supabase
      .from('orders')
      .select('*, order_items(*)')
      .eq('external_order_id', externalOrderId)
      .maybeSingle();

    if (existingOrder) {
      const updateData = {
        status:
          payment_status === 'SUCCESS' || order_status === 'PAID'
            ? 'PAID'
            : order_status,
        payment_status: payment_status,
        transaction_id:
          transaction_id || payment_session_id || existingOrder.transaction_id,
        updated_at: new Date().toISOString(),
      };

      const { error } = await supabase
        .from('orders')
        .update(updateData)
        .eq('id', existingOrder.id);

      if (error) throw error;
    } else {
      const newOrder = {
        external_order_id: externalOrderId,
        customer_name: customer_details?.customer_name || 'Customer',
        customer_phone: customer_details?.customer_phone || '',
        status:
          payment_status === 'SUCCESS' || order_status === 'PAID'
            ? 'PAID'
            : order_status,
        payment_status: payment_status,
        transaction_id: transaction_id || payment_session_id,
        total_amount: Number(order_amount),
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
      };

      const { error } = await supabase.from('orders').insert(newOrder);
      if (error) throw error;
    }

    const { data: updatedOrderForPayment } = await supabase
      .from('orders')
      .select('id')
      .eq('external_order_id', externalOrderId)
      .maybeSingle();

    await supabase.from('payments').insert({
      order_id: updatedOrderForPayment?.id || null,
      provider: 'cashfree',
      status: payment_status,
      amount: Number(order_amount),
      currency: 'INR',
      session_id: payment_session_id,
      provider_order_id: externalOrderId,
      transaction_id: transaction_id,
      raw_response: body,
      created_at: new Date().toISOString(),
    });

    if (payment_status === 'SUCCESS' || order_status === 'PAID') {
      const toPhone =
        customer_details?.customer_phone ||
        env.WHATSAPP_TEST_TO ||
        env.DEFAULT_TEST_WHATSAPP_TO;
      const templateName =
        env.WHATSAPP_ORDER_TEMPLATE_NAME || env.WHATSAPP_TEMPLATE_NAME;
      const languageCode =
        env.WHATSAPP_ORDER_TEMPLATE_LANGUAGE ||
        env.WHATSAPP_TEMPLATE_LANGUAGE ||
        'en_US';

      if (toPhone && templateName) {
        const templateValues = {
          orderId: externalOrderId,
          totalCost: typeof order_amount !== 'undefined' ? String(order_amount) : '',
          customerName: customer_details?.customer_name || '',
          customerPhone: customer_details?.customer_phone || '',
        };

        const itemsList = existingOrder?.order_items?.map(i => `- ${i.product_name} (x${i.quantity})`).join('\n') || 'No items info';
        const address = existingOrder?.customer_address || 'Address not provided';

        const slackMessage = `🎉 *New Order Received!* 🎉\n\n*Order ID:* ${externalOrderId}\n*Customer:* ${customer_details?.customer_name || 'N/A'}\n*Phone:* ${customer_details?.customer_phone || 'N/A'}\n*Amount:* ₹${order_amount}\n*Payment Status:* ${payment_status}\n\n*Items:*\n${itemsList}\n\n*Address:*\n${address}\n\n<https://business.woody.co.in/sr-admin/orders/${externalOrderId}|View Order in Admin Panel>`;

        // Send Slack Notification
        sendSlackNotification(env, slackMessage).catch(console.error);

        // Trigger Shipping Order Creation (Fire and forget)
        createShippingOrder(env, externalOrderId).catch(console.error);


        const bodyKeys = (env.WHATSAPP_ORDER_TEMPLATE_BODY_KEYS ||
          env.WHATSAPP_TEMPLATE_BODY_KEYS ||
          'customerName,orderId,totalCost')
          .split(',')
          .map((k) => k.trim())
          .filter(Boolean);
        const headerKeys = (env.WHATSAPP_ORDER_TEMPLATE_HEADER_KEYS ||
          env.WHATSAPP_TEMPLATE_HEADER_KEYS ||
          '')
          .split(',')
          .map((k) => k.trim())
          .filter(Boolean);

        const bodyParameters = bodyKeys.map(
          (key) => templateValues[key] || ''
        );
        const headerParameters = headerKeys.map(
          (key) => templateValues[key] || ''
        );




        await sendWhatsAppTemplateMessage(env, {
          to: toPhone,
          templateName,
          languageCode,
          bodyParameters,
          headerParameters,
        });
      }
    }

    return new Response(JSON.stringify({ success: true }), {
      status: 200,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(),
      },
    });
  } catch (error) {
    const message =
      error && typeof error === 'object' && 'message' in error
        ? String(error.message)
        : 'Webhook processing failed';

    return new Response(
      JSON.stringify({
        error: 'Webhook processing failed',
        details: message,
      }),
      {
        status: 500,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      }
    );
  }
}

