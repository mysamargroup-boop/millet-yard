  return { success: true, mock: true };
}

async function handleSendEmail(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  if (request.method !== 'POST') {
    return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers: getCORSHeaders(env, request) });
  }

  try {
    const { to, subject, html } = await request.json();
    if (!to || !subject || !html) {
      return new Response(JSON.stringify({ error: 'Missing required fields' }), { status: 400, headers: getCORSHeaders(env, request) });
    }

    const result = await sendEmailViaApi(env, { to, subject, html });
    return new Response(JSON.stringify(result), { status: 200, headers: getCORSHeaders(env, request) });

  } catch (error) {
    return new Response(JSON.stringify({ error: error.message }), { status: 500, headers: getCORSHeaders(env, request) });
  }
}

// Router
export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    const path = url.pathname;

    if (path.startsWith('/api/categories')) {
      return handleCategories(request, env);
    }
    if (path.startsWith('/api/products')) {
      return handleProducts(request, env);
    }
    if (path.startsWith('/api/orders')) {
      return handleOrders(request, env);
    }
    if (path.startsWith('/api/auth/otp/request')) {
      return handleAuthRequestOTP(request, env);
    }
    if (path.startsWith('/api/auth/otp/verify')) {
      return handleAuthVerifyOTP(request, env);
    }
    if (path.startsWith('/api/webhooks/cashfree')) {
      return handleCashfreeWebhook(request, env);
    }
    if (path.startsWith('/api/send-email')) {
      return handleSendEmail(request, env);
    }
    if (path.startsWith('/api/account/addresses')) {
      return handleCustomerAddresses(request, env);
    }

    // Default response for unknown routes
    return new Response(
      JSON.stringify({ error: 'Route not found' }),
      {
        status: 404,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      }
    );
  },

  // Scheduled handler for cron jobs (runs every hour)
  async scheduled(event, env, ctx) {
    console.log('[Cron] Running scheduled task at', new Date().toISOString());

    try {
      const supabase = createSupabaseAdmin(env);

      // 1. Check if cart abandonment is enabled
      const { data: settings } = await supabase
        .from('site_settings')
        .select('cart_abandonment_enabled, cart_abandonment_delay_hours, cart_abandonment_whatsapp_template')
        .maybeSingle();

      if (!settings?.cart_abandonment_enabled) {
        console.log('[Cron] Cart abandonment disabled');
        return;
      }

      const delayHours = settings.cart_abandonment_delay_hours || 2;
      const templateName = settings.cart_abandonment_whatsapp_template || 'cart_reminder';

      // 2. Get abandoned carts older than delay hours with phone numbers
      const cutoffTime = new Date(Date.now() - (delayHours * 60 * 60 * 1000)).toISOString();

      const { data: abandonedCarts, error: fetchError } = await supabase
        .from('abandoned_carts')
        .select('*')
        .eq('recovery_status', 'pending')
        .not('customer_phone', 'is', null)
        .lt('created_at', cutoffTime)
        .limit(50); // Process max 50 per hour

      if (fetchError) {
        console.error('[Cron] Error fetching abandoned carts:', fetchError);
        return;
      }

      if (!abandonedCarts || abandonedCarts.length === 0) {
        console.log('[Cron] No abandoned carts to process');
        return;
      }

      console.log(`[Cron] Found ${abandonedCarts.length} abandoned carts to remind`);

      // 3. Send WhatsApp reminders
      for (const cart of abandonedCarts) {
        try {
          // Format phone number for WhatsApp
          let phone = cart.customer_phone.replace(/\D/g, '');
          if (!phone.startsWith('91') && phone.length === 10) {
            phone = '91' + phone;
          }

          // Get first item name for personalization
          const items = cart.cart_items || [];
          const firstItemName = items[0]?.name || 'your items';
          const itemCount = items.length;
          const totalAmount = cart.total_amount || 0;
          const cartUrl = `${env.PUBLIC_URL || 'https://business.woody.co.in'}/cart`;

          // Create personalized message
          const customerName = cart.customer_name || 'Dear Customer';
          const messageBody = `Hi ${customerName}! 🛒

You left ${itemCount} item(s) in your cart worth ₹${totalAmount}.

🎁 *${firstItemName}* and more are waiting for you!

Complete your order now: ${cartUrl}

Need help? Reply to this message!`;

          // Send WhatsApp text message (not template)
          const whatsappResponse = await sendWhatsAppTextMessage(env, {
            to: phone,
            body: messageBody,
            previewUrl: true
          });

          // Update cart status
          await supabase
            .from('abandoned_carts')
            .update({
              recovery_status: 'reminder_sent',
              reminder_sent_at: new Date().toISOString()
            })
            .eq('id', cart.id);

          console.log(`[Cron] Sent reminder to ${phone}`);

        } catch (sendError) {
          console.error(`[Cron] Failed to send reminder for cart ${cart.id}:`, sendError);
        }
      }

      // 4. Cleanup old carts (expired after 15 days)
      const fifteenDaysAgo = new Date(Date.now() - (15 * 24 * 60 * 60 * 1000)).toISOString();
      await supabase
        .from('abandoned_carts')
        .update({ recovery_status: 'expired' })
        .eq('recovery_status', 'pending')
        .lt('created_at', fifteenDaysAgo);

      // Delete carts older than 30 days
      const thirtyDaysAgo = new Date(Date.now() - (30 * 24 * 60 * 60 * 1000)).toISOString();
      await supabase
        .from('abandoned_carts')
        .delete()
        .lt('created_at', thirtyDaysAgo);

      console.log('[Cron] Completed cart abandonment processing');

    } catch (error) {
      console.error('[Cron] Error in scheduled task:', error);
    }
  },
};

// Address Book Handler
async function handleCustomerAddresses(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  const supabase = createSupabaseAdmin(env);

  try {
    if (request.method === 'GET') {
      const url = new URL(request.url);
      const phone = url.searchParams.get('phone');

      if (!phone) {
        return new Response(JSON.stringify({ error: 'Phone number required' }), { status: 400, headers: getCORSHeaders(env, request) });
      }

      const { data, error } = await supabase
        .from('customers')
        .select('address_json')
        .eq('phone', phone)
        .maybeSingle();

      if (error) throw error;

      return new Response(JSON.stringify({ addresses: data?.address_json || [] }), {
        status: 200,
        headers: { 'Content-Type': 'application/json', ...getCORSHeaders(env, request) }
      });
    }

    if (request.method === 'POST') {
      const { phone, addresses } = await request.json();

      if (!phone || !Array.isArray(addresses)) {
        return new Response(JSON.stringify({ error: 'Phone and addresses array required' }), { status: 400, headers: getCORSHeaders(env, request) });
      }

      const { error } = await supabase
        .from('customers')
        .update({
          address_json: addresses,
          updated_at: new Date().toISOString()
        })
        .eq('phone', phone);

      if (error) throw error;

      return new Response(JSON.stringify({ success: true }), {
        status: 200,
        headers: { 'Content-Type': 'application/json', ...getCORSHeaders(env, request) }
      });
    }

    return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers: getCORSHeaders(env, request) });

  } catch (error) {
    console.error('Address API Error:', error);
    return new Response(JSON.stringify({ error: error.message }), { status: 500, headers: getCORSHeaders(env, request) });
  }
}

async function handleCategories(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  try {
    const supabase = createSupabaseAdmin(env);

    if (request.method === 'GET') {
      const { data, error } = await supabase
        .from('categories')
        .select('*')
        .order('name');

      if (error) throw error;

      // Transform snake_case to camelCase for frontend compatibility
      const transformedData = (data || []).map(cat => ({
        ...cat,
        imageUrl: cat.image_url || null,
        imageHint: cat.image_hint || '',
        linkUrl: cat.link_url || null,
        is_featured: cat.is_featured || false,
        featured_order: cat.featured_order || 0,
        createdAt: cat.created_at,
        updatedAt: cat.updated_at,
      }));

      return new Response(JSON.stringify(transformedData), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    if (request.method !== 'POST') {
      return new Response(
        JSON.stringify({ error: 'Method not allowed' }),
        {
          status: 405,
          headers: {
            'Content-Type': 'application/json',
            ...getCORSHeaders(env, request),
          },
        }
      );
    }

    let payload = {};
    try {
      const json = await request.json();
      payload = json || {};
    } catch {
      payload = { action: 'list' };
    }

    if (!payload || typeof payload !== 'object') {
      payload = { action: 'list' };
    }

    if (payload.action === 'list' || payload.action === undefined) {
      const { data, error } = await supabase
        .from('categories')
        .select('*')
        .order('name');

      if (error) throw error;

      return new Response(JSON.stringify(data || []), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    if (payload.action === 'create') {
      const { data, error } = await supabase
        .from('categories')
        .insert(payload.data)
        .select()
        .maybeSingle();

      if (error) throw error;

      return new Response(JSON.stringify(data || null), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    return new Response(
      JSON.stringify({ error: 'Invalid action' }),
      {
        status: 400,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      }
    );
  } catch (error) {
    const message =
      error && typeof error === 'object' && 'message' in error
        ? String(error.message)
        : 'Unexpected error';

    return new Response(JSON.stringify({ error: message }), {
      status: 500,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(),
      },
    });
  }
}

// Route handler for create-order
async function handleCreateOrder(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  if (request.method !== 'POST') {
    return new Response(
      JSON.stringify({ error: 'Method not allowed' }),
      {
        status: 405,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      }
    );
  }

  try {
    const input = await request.json();

    // Input validation
    validateOrderInput(input);

    const { orderId, customerName, customerPhone, customerEmail, returnUrl, items, couponCode, extraNote, customerAddress } = input;

    const envType = env.CASHFREE_ENV?.trim().toUpperCase() || 'SANDBOX';
    const cashfreeConfig = {
      env: envType,
      baseUrl: envType === 'PRODUCTION' ? 'https://api.cashfree.com/pg' : 'https://sandbox.cashfree.com/pg',
      appId: env.CASHFREE_APP_ID?.trim(),
      secretKey: env.CASHFREE_SECRET_KEY?.trim(),
    };

    if (!cashfreeConfig.appId || !cashfreeConfig.secretKey) {
      throw new Error('Cashfree credentials missing in environment variables.');
    }

    const supabaseAdmin = createSupabaseAdmin(env);

    // IDEMPOTENCY CHECK: Check if order already exists
    const { data: existingOrder } = await supabaseAdmin
      .from('orders')
      .select('id, status, payment_status, total_amount')
      .eq('external_order_id', String(orderId))
      .single();

    if (existingOrder) {
      return new Response(JSON.stringify({
        order_id: existingOrder.external_order_id,
        payment_session_id: null,
        env: envType,
        existing: true,
        status: existingOrder.status,
        payment_status: existingOrder.payment_status,
      }), {
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
        status: 200,
      });
    }

    // SECURITY: Calculate total amount from database instead of trusting client
    let calculatedTotalAmount = 0;
    let validatedItems = [];

    if (items && items.length > 0) {
      const productIds = items.map((item) => item.id).filter(Boolean);

      if (productIds.length > 0) {
        const { data: products, error: productError } = await supabaseAdmin
          .from('products')
          .select('id, sale_price, regular_price, name')
          .in('id', productIds);

        if (productError) {
          throw new Error('Failed to fetch product prices');
        }

        const productMap = new Map(
          products?.map((product) => [product.id, product]) || []
        );

        validatedItems = items.map((item) => {
          const product = productMap.get(item.id);
          if (!product) {
            throw new Error(`Product with ID ${item.id} not found`);
          }

          // Use sale_price if available, otherwise regular_price
          const price = product.sale_price || product.regular_price || 0;
          const quantity = Number(item.quantity) || 1;
          const unitPrice = Number(price);
          const totalPrice = unitPrice * quantity;

          calculatedTotalAmount += totalPrice;

          return {
            product_id: item.id,
            product_name: product.name,
            sku: item.id,
            quantity,
            unit_price: unitPrice,
            total_price: totalPrice,
            image_url: item.imageUrl, // Optional: still trust client for image URL as it's display only, or fetch?
            image_hint: item.imageHint,
          };
        });
      }
    }

    // Ensure we have a valid amount
    if (calculatedTotalAmount <= 0) {
      // Fallback? No, strict mode.
      // If "amount" was passed for custom orders (advance payment?), we might need logic.
      // But for now, assume rigorous product-based checkout.
      // Exception: "Advance Payment" logic often uses arbitrary amount.
      // If specific advance logic is needed, we'd handle it here.
      // For now, enforcing product price sum.
      // If no items, checks fail.
      if (!items || items.length === 0) throw new Error("No items in order");
    }

    // SECURITY: Server-side coupon validation and discount calculation
    let couponDiscount = 0;
    let validatedCouponCode = null;

    if (couponCode) {
      const code = String(couponCode).trim().toUpperCase();
      const { data: coupon, error: couponError } = await supabaseAdmin
        .from('coupons')
        .select('*')
        .eq('code', code)
        .eq('active', true)
        .maybeSingle();

      if (!couponError && coupon) {
        // Double check expiry if field exists (schema dependent, usually active is enough or expiry date)
        // Assume 'active' handles it for now as per schema
        validatedCouponCode = coupon.code;
        if (coupon.type === 'percent') {
          couponDiscount = (calculatedTotalAmount * (Number(coupon.value) / 100));
        } else if (coupon.type === 'flat') {
          couponDiscount = Number(coupon.value);
        }
        // Cap discount at total
        couponDiscount = Math.min(calculatedTotalAmount, couponDiscount);
      }
      // If coupon is invalid, we silently ignore it (don't fail the order)
    }

    const amountAfterDiscount = Math.max(1, calculatedTotalAmount - couponDiscount);

    // 1. Save Order to Supabase in 'PENDING' state
    const { data: orderData, error: orderError } = await supabaseAdmin
      .from('orders')
      .insert({
        external_order_id: String(orderId),
        customer_name: customerName || 'Customer',
        customer_phone: String(customerPhone),
        // customer_email: customerEmail,
        status: 'PENDING',
        payment_status: 'PENDING',
        // subtotal_amount: calculatedTotalAmount,
        total_amount: amountAfterDiscount,
        // coupon_code: validatedCouponCode,
        // discount_amount: couponDiscount,
        customer_address: customerAddress || 'Address not provided'
      })
      .select()
      .single();

    if (orderError) throw orderError;

    // 2. Create order items using validated data
    if (validatedItems.length > 0) {
      const orderItems = validatedItems.map((item) => ({
        order_id: orderData.id,
        ...item,
      }));
      const { error: itemsError } = await supabaseAdmin.from('order_items').insert(orderItems);
      if (itemsError) throw itemsError;
    }

    // 3. Create Cashfree order with discounted amount
    const requestBody = {
      order_id: orderId,
      order_amount: amountAfterDiscount,
      order_currency: 'INR',
      customer_details: {
        customer_id: String(customerPhone).replace(/[^a-zA-Z0-9_-]/g, ''),
        customer_name: customerName,
        customer_email: customerEmail || `customer-${Date.now()}@example.com`,
        customer_phone: String(customerPhone),
      },
      order_meta: {
        return_url: `${returnUrl}?order_id=${orderId}`,
        notify_url: `${new URL(request.url).origin}/cashfree-webhook`,
      },
      order_note: extraNote || '',
    };

    const cashfreeResponse = await fetch(`${cashfreeConfig.baseUrl}/orders`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-version': '2023-08-01',
        'x-client-id': cashfreeConfig.appId,
        'x-client-secret': cashfreeConfig.secretKey,
      },
      body: JSON.stringify(requestBody),
    });

    const cashfreeData = await cashfreeResponse.json();

    if (!cashfreeResponse.ok) {
      throw new Error(cashfreeData.message || 'Cashfree order creation failed');
    }

    // 4. Track coupon redemption (Moved to Webhook or here? Webhook is safer for actual usage, but here reserves it)
    // Actually, usually on payment success. But let's log it if needed.
    // The previous implementation added it here. We'll stick to that or rely on order table `coupon_code` col.
    // Explicit table tracking:
    if (validatedCouponCode && couponDiscount > 0) {
      await supabaseAdmin.from('coupon_redemptions').insert({
        order_id: orderData.id,
        coupon_code: validatedCouponCode,
        discount_amount: couponDiscount
      });
    }

    return new Response(JSON.stringify({
      order_id: cashfreeData.order_id,
      payment_session_id: cashfreeData.payment_session_id,
      env: envType,
    }), {
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(),
      },
      status: 200,
    });

  } catch (error) {
    console.error('Create Order Error:', error);
    return new Response(JSON.stringify({ error: error.message }), {
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(env, request),
      },
      status: 500,
    });
  }
}

// Route handler for create-payment
async function handleCreatePayment(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  if (request.method !== 'POST') {
    return new Response(
      JSON.stringify({ error: 'Method not allowed' }),
      {
        status: 405,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      }
    );
  }

  try {
    const { orderId, amount, customerName, customerPhone, customerEmail, returnUrl, items, couponCode } = await request.json();

    const envType = env.CASHFREE_ENV?.trim().toUpperCase() || 'SANDBOX';
    const cashfreeConfig = {
      env: envType,
      baseUrl: envType === 'PRODUCTION' ? 'https://api.cashfree.com/pg' : 'https://sandbox.cashfree.com/pg',
      appId: env.CASHFREE_APP_ID?.trim(),
      secretKey: env.CASHFREE_SECRET_KEY?.trim(),
    };

    if (!cashfreeConfig.appId || !cashfreeConfig.secretKey) {
      throw new Error('Cashfree credentials missing in environment variables.');
    }
    if (!orderId || !amount || !customerPhone) {
      throw new Error('Missing required fields: orderId, amount, and customerPhone are required.');
    }

    const supabaseAdmin = createSupabaseAdmin(env);

    // IDEMPOTENCY CHECK: Check if order already exists
    const { data: existingOrder } = await supabaseAdmin
      .from('orders')
      .select('id, status, payment_status, total_amount')
      .eq('external_order_id', String(orderId))
      .single();

    if (existingOrder) {
      return new Response(JSON.stringify({
        order_id: existingOrder.external_order_id,
        payment_session_id: null,
        env: envType,
        existing: true,
        status: existingOrder.status,
        payment_status: existingOrder.payment_status,
      }), {
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
        status: 200,
      });
    }

    // SECURITY: Calculate total amount from database instead of trusting client
    let calculatedTotalAmount = 0;
    let validatedItems = [];

    if (items && items.length > 0) {
      const productIds = items.map((item) => item.id).filter(Boolean);

      if (productIds.length > 0) {
        const { data: products, error: productError } = await supabaseAdmin
          .from('products')
          .select('id, price, name')
          .in('id', productIds);

        if (productError) {
          throw new Error('Failed to fetch product prices');
        }

        const productMap = new Map(
          products?.map((product) => [product.id, product]) || []
        );

        validatedItems = items.map((item) => {
          const product = productMap.get(item.id);
          if (!product) {
            throw new Error(`Product with ID ${item.id} not found`);
          }

          const quantity = Number(item.quantity) || 1;
          const unitPrice = Number(product.price);
          const totalPrice = unitPrice * quantity;

          calculatedTotalAmount += totalPrice;

          return {
            product_id: item.id,
            product_name: product.name,
            sku: item.id,
            quantity,
            unit_price: unitPrice,
            total_price: totalPrice,
            image_url: item.imageUrl,
            image_hint: item.imageHint,
          };
        });
      }
    }

    const finalAmount = calculatedTotalAmount > 0 ? calculatedTotalAmount : Number(amount);
    if (finalAmount <= 0) {
      throw new Error('Invalid order amount');
    }

    // SECURITY: Server-side coupon validation and discount calculation
    let couponDiscount = 0;
    let validatedCouponCode = null;

    if (couponCode) {
      const code = String(couponCode).trim().toUpperCase();
      const { data: coupon, error: couponError } = await supabaseAdmin
        .from('coupons')
        .select('*')
        .eq('code', code)
        .eq('active', true)
        .maybeSingle();

      if (!couponError && coupon) {
        validatedCouponCode = coupon.code;
        if (coupon.type === 'percent') {
          couponDiscount = Math.min(finalAmount, finalAmount * (Number(coupon.value) / 100));
        } else if (coupon.type === 'flat') {
          couponDiscount = Math.min(finalAmount, Number(coupon.value));
        }
      }
    }

    const amountAfterDiscount = Math.max(1, finalAmount - couponDiscount);

    // 1. Save Order to Supabase in 'PENDING' state
    const { data: orderData, error: orderError } = await supabaseAdmin
      .from('orders')
      .insert({
        external_order_id: String(orderId),
        customer_name: customerName || 'Customer',
        customer_phone: String(customerPhone),
        status: 'PENDING',
        payment_status: 'PENDING',
        subtotal_amount: finalAmount,
        total_amount: amountAfterDiscount,
      })
      .select()
      .single();

    if (orderError) throw orderError;

    // 2. Create order items using validated data
    if (validatedItems.length > 0) {
      const orderItems = validatedItems.map((item) => ({
        order_id: orderData.id,
        ...item,
      }));
      const { error: itemsError } = await supabaseAdmin.from('order_items').insert(orderItems);
      if (itemsError) throw itemsError;
    }

    // 3. Create Cashfree Order with discounted amount
    const requestBody = {
      order_id: String(orderId),
      order_amount: amountAfterDiscount,
      order_currency: 'INR',
      customer_details: {
        customer_id: String(customerPhone).replace(/[^a-zA-Z0-9_-]/g, ''),
        customer_phone: String(customerPhone),
        customer_name: customerName || 'Customer',
        customer_email: customerEmail || `customer-${Date.now()}@example.com`,
      },
      order_meta: {
        return_url: `${returnUrl}?order_id={order_id}`,
      },
    };

    const cashfreeResponse = await fetch(`${cashfreeConfig.baseUrl}/orders`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-version': '2023-08-01',
        'x-client-id': cashfreeConfig.appId,
        'x-client-secret': cashfreeConfig.secretKey,
      },
      body: JSON.stringify(requestBody),
    });

    const cashfreeData = await cashfreeResponse.json();

    if (!cashfreeResponse.ok) {
      throw new Error(cashfreeData.message || 'Cashfree order creation failed');
    }

    // 4. Track coupon usage if coupon was applied and valid
    if (validatedCouponCode && couponDiscount > 0) {
      try {
        await supabaseAdmin
          .from('coupon_redemptions')
          .insert({
            order_id: orderData.id,
            coupon_code: validatedCouponCode,
            discount_amount: couponDiscount,
          });
      } catch (couponError) {
        console.error('Failed to track coupon redemption:', couponError);
      }
    }

    return new Response(JSON.stringify({
      order_id: cashfreeData.order_id,
      payment_session_id: cashfreeData.payment_session_id,
      env: envType,
    }), {
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(),
      },
      status: 200,
    });

  } catch (error) {
    return new Response(JSON.stringify({ error: error.message }), {
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(),
      },
      status: 500,
    });
  }
}

// Route handler for orders-admin
async function handleOrdersAdmin(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  if (request.method !== 'POST') {
    return new Response(
      JSON.stringify({ error: 'Method not allowed' }),
      {
        status: 405,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      }
    );
  }

  try {
    const payload = await request.json();
    const supabase = createSupabaseAdmin(env);

    if (payload.action === 'list') {
      const { data, error } = await supabase
        .from('orders')
        .select('*')
        .order('created_at', { ascending: false });

      if (error) throw error;

      return new Response(JSON.stringify(data || []), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    if (payload.action === 'getById') {
      const { data, error } = await supabase
        .from('orders')
        .select('*, order_items(*)')
        .eq('id', payload.orderId)
        .maybeSingle();

      if (error) throw error;

      return new Response(JSON.stringify(data || null), {
        status: data ? 200 : 404,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    if (payload.action === 'getByExternalId') {
      const { data, error } = await supabase
        .from('orders')
        .select('*, order_items(*)')
        .eq('external_order_id', payload.externalOrderId)
        .maybeSingle();

      if (error) {
        if (error.code === 'PGRST116') {
          return new Response(
            JSON.stringify({ error: 'Order not found' }),
            {
              status: 404,
              headers: {
                'Content-Type': 'application/json',
                ...getCORSHeaders(env, request),
              },
            },
          );
        }
        throw error;
      }

      return new Response(JSON.stringify(data || null), {
        status: data ? 200 : 404,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    if (payload.action === 'history') {
      const { data, error } = await supabase
        .from('order_status_history')
        .select('*')
        .eq('order_id', payload.orderId)
        .order('created_at', { ascending: false });

      if (error) throw error;

      return new Response(JSON.stringify(data || []), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    if (payload.action === 'cancel') {
      const { data: order, error: fetchError } = await supabase
        .from('orders')
        .select('*')
        .eq('id', payload.orderId)
        .maybeSingle();

      if (fetchError) throw fetchError;
      if (!order) {
        return new Response(
          JSON.stringify({ error: 'Order not found' }),
          {
            status: 404,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            },
          },
        );
      }

      const { data: updatedOrder, error } = await supabase
        .from('orders')
        .update({
          status: 'CANCELLED',
          admin_notes: payload.adminNote ?? null,
          updated_at: new Date().toISOString(),
        })
        .eq('id', payload.orderId)
        .select()
        .maybeSingle();

      if (error) throw error;

      await supabase.from('order_status_history').insert({
        order_id: payload.orderId,
        old_status: order.status,
        new_status: 'CANCELLED',
        reason: payload.cancelReason ?? null,
        admin_note: payload.adminNote ?? null,
        created_by: 'admin',
        created_at: new Date().toISOString(),
      });

      return new Response(
        JSON.stringify({ success: true, order: updatedOrder }),
        {
          status: 200,
          headers: {
            'Content-Type': 'application/json',
            ...getCORSHeaders(env, request),
          },
        },
      );
    }

    if (payload.action === 'return') {
      const { data: order, error: fetchError } = await supabase
        .from('orders')
        .select('*')
        .eq('id', payload.orderId)
        .maybeSingle();

      if (fetchError) throw fetchError;
      if (!order) {
        return new Response(
          JSON.stringify({ error: 'Order not found' }),
          {
            status: 404,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            },
          },
        );
      }

      const { data: updatedOrder, error } = await supabase
        .from('orders')
        .update({
          status: 'RETURNED',
          return_reason: payload.returnReason ?? null,
          admin_notes: payload.adminNote ?? null,
          updated_at: new Date().toISOString(),
        })
        .eq('id', payload.orderId)
        .select()
        .maybeSingle();

      if (error) throw error;

      await supabase.from('order_status_history').insert({
        order_id: payload.orderId,
        old_status: order.status,
        new_status: 'RETURNED',
        reason: payload.returnReason ?? null,
        admin_note: payload.adminNote ?? null,
        created_by: 'admin',
        created_at: new Date().toISOString(),
      });

      return new Response(
        JSON.stringify({ success: true, order: updatedOrder }),
        {
          status: 200,
          headers: {
            'Content-Type': 'application/json',
            ...getCORSHeaders(env, request),
          },
        },
      );
    }

    if (payload.action === 'refund') {
      const { data: order, error: fetchError } = await supabase
        .from('orders')
        .select('*')
        .eq('id', payload.orderId)
        .maybeSingle();

      if (fetchError) throw fetchError;
      if (!order) {
        return new Response(
          JSON.stringify({ error: 'Order not found' }),
          {
            status: 404,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            },
          },
        );
      }

      const { data: updatedOrder, error } = await supabase
        .from('orders')
        .update({
          status: 'REFUNDED',
          refund_amount: payload.refundAmount,
          refund_reason: payload.refundReason ?? null,
          admin_notes: payload.adminNote ?? null,
          updated_at: new Date().toISOString(),
        })
        .eq('id', payload.orderId)
        .select()
        .maybeSingle();

      if (error) throw error;

      await supabase.from('order_status_history').insert({
        order_id: payload.orderId,
        old_status: order.status,
        new_status: 'REFUNDED',
        reason: payload.refundReason ?? null,
        admin_note: payload.adminNote ?? null,
        created_by: 'admin',
        created_at: new Date().toISOString(),
      });

      return new Response(
        JSON.stringify({ success: true, order: updatedOrder }),
        {
          status: 200,
          headers: {
            'Content-Type': 'application/json',
            ...getCORSHeaders(env, request),
          },
        },
      );
    }

    return new Response(
      JSON.stringify({ error: 'Invalid action' }),
      {
        status: 400,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      },
    );
  } catch (error) {
    const message =
      error && typeof error === 'object' && 'message' in error
        ? String(error.message)
        : 'Unexpected error';

    return new Response(JSON.stringify({ error: message }), {
      status: 500,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(),
      },
    });
  }
}





// Route handler for products-admin
async function handleProductsAdmin(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  if (request.method !== 'POST') {
    return new Response(
      JSON.stringify({ error: 'Method not allowed' }),
      {
        status: 405,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      }
    );
  }

  try {
    const payload = await request.json();
    const supabase = createSupabaseAdmin(env);

    if (payload.action === 'list') {
      const { data, error } = await supabase
        .from('products')
        .select('*')
        .order('created_at', { ascending: false });

      if (error) throw error;

      return new Response(JSON.stringify(data || []), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    if (payload.action === 'create') {
      // Check for existing order to prevent duplicates
      const { data: existingOrder } = await supabase
        .from('orders')
        .select('id')
        .eq('external_order_id', payload.data.external_order_id)
        .single();

      if (existingOrder) {
        return new Response(
          JSON.stringify({ error: 'Order already exists', order: existingOrder }),
          {
            status: 409,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            },
          }
        );
      }

      const { data, error } = await supabase
        .from('orders')
        .insert(payload.data)
        .select()
        .maybeSingle();

      if (error) throw error;

      return new Response(JSON.stringify(data || null), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    return new Response(
      JSON.stringify({ error: 'Invalid action' }),
      {
        status: 400,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      },
    );
  } catch (error) {
    const message =
      error && typeof error === 'object' && 'message' in error
        ? String(error.message)
        : 'Unexpected error';

    return new Response(JSON.stringify({ error: message }), {
      status: 500,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(env, request),
      },
    });
  }
}

// Route handler for coupons-admin
async function handleCouponsAdmin(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  if (request.method !== 'POST') {
    return new Response(
      JSON.stringify({ error: 'Method not allowed' }),
      {
        status: 405,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      }
    );
  }

  try {
    const payload = await request.json();
    const supabase = createSupabaseAdmin(env);

    if (!payload || typeof payload !== 'object') {
      return new Response(
        JSON.stringify({ error: 'Invalid request payload' }),
        {
          status: 400,
          headers: {
            'Content-Type': 'application/json',
            ...getCORSHeaders(env, request),
          },
        }
      );
    }

    if (!payload.action || payload.action === 'list') {
      const { data, error } = await supabase
        .from('coupons')
        .select('*')
        .order('code');

      if (error) throw error;

      return new Response(JSON.stringify(data || []), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    if (payload.action === 'create') {
      const input = payload.data || {};
      const code =
        typeof input.code === 'string'
          ? input.code.trim().toUpperCase()
          : '';

      if (!code) {
        return new Response(
          JSON.stringify({ error: 'Coupon code is required' }),
          {
            status: 400,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            },
          }
        );
      }

      const { data: existing, error: existingError } = await supabase
        .from('coupons')
        .select('code')
        .eq('code', code)
        .maybeSingle();

      if (existingError && existingError.code !== 'PGRST116') {
        throw existingError;
      }

      if (existing) {
        return new Response(
          JSON.stringify({ error: 'Coupon code already exists.' }),
          {
            status: 400,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            },
          }
        );
      }

      const insertPayload = {
        code,
        type: input.type,
        value: input.value,
        active: input.active !== undefined ? Boolean(input.active) : true,
        show_on_offers_page:
          input.show_on_offers_page !== undefined
            ? Boolean(input.show_on_offers_page)
            : false,
      };

      const { data, error } = await supabase
        .from('coupons')
        .insert(insertPayload)
        .select()
        .maybeSingle();

      if (error) throw error;

      return new Response(
        JSON.stringify({ success: true, coupon: data || null }),
        {
          status: 200,
          headers: {
            'Content-Type': 'application/json',
            ...getCORSHeaders(env, request),
          },
        }
      );
    }

    if (payload.action === 'update') {
      const input = payload.data || {};
      const originalCode =
        typeof input.originalCode === 'string'
          ? input.originalCode.trim().toUpperCase()
          : '';
      const newCode =
        typeof input.code === 'string'
          ? input.code.trim().toUpperCase()
          : '';

      if (!originalCode || !newCode) {
        return new Response(
          JSON.stringify({ error: 'Original and new coupon codes are required' }),
          {
            status: 400,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            },
          }
        );
      }

      if (originalCode !== newCode) {
        const { data: exists, error: existsError } = await supabase
          .from('coupons')
          .select('code')
          .eq('code', newCode)
          .maybeSingle();

        if (existsError && existsError.code !== 'PGRST116') {
          throw existsError;
        }

        if (exists) {
          return new Response(
            JSON.stringify({
              error: 'The new coupon code already exists.',
            }),
            {
              status: 400,
              headers: {
                'Content-Type': 'application/json',
                ...getCORSHeaders(env, request),
              },
            }
          );
        }
      }

      const updatePayload = {
        code: newCode,
        type: input.type,
        value: input.value,
        show_on_offers_page:
          input.show_on_offers_page !== undefined
            ? Boolean(input.show_on_offers_page)
            : false,
      };

      const { data, error } = await supabase
        .from('coupons')
        .update(updatePayload)
        .eq('code', originalCode)
        .select()
        .maybeSingle();

      if (error) throw error;

      return new Response(
        JSON.stringify({ success: true, coupon: data || null }),
        {
          status: 200,
          headers: {
            'Content-Type': 'application/json',
            ...getCORSHeaders(env, request),
          },
        }
      );
    }

    if (payload.action === 'delete') {
      const code =
        typeof payload.code === 'string'
          ? payload.code.trim().toUpperCase()
          : '';

      if (!code) {
        return new Response(
          JSON.stringify({ error: 'Coupon code is required' }),
          {
            status: 400,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            },
          }
        );
      }

      const { error } = await supabase
        .from('coupons')
        .delete()
        .eq('code', code);

      if (error) throw error;

      return new Response(JSON.stringify({ success: true }), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    if (payload.action === 'toggle-status') {
      const code =
        typeof payload.code === 'string'
          ? payload.code.trim().toUpperCase()
          : '';

      if (!code) {
        return new Response(
          JSON.stringify({ error: 'Coupon code is required' }),
          {
            status: 400,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            },
          }
        );
      }

      const { data: coupon, error: fetchError } = await supabase
        .from('coupons')
        .select('active')
        .eq('code', code)
        .maybeSingle();

      if (fetchError) throw fetchError;

      if (!coupon) {
        return new Response(
          JSON.stringify({ error: 'Coupon not found' }),
          {
            status: 404,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            },
          }
        );
      }

      const current = Boolean(coupon.active);

      const { error } = await supabase
        .from('coupons')
        .update({ active: !current })
        .eq('code', code);

      if (error) throw error;

      return new Response(
        JSON.stringify({ success: true, active: !current }),
        {
          status: 200,
          headers: {
            'Content-Type': 'application/json',
            ...getCORSHeaders(env, request),
          },
        }
      );
    }

    if (payload.action === 'toggle-visibility') {
      const code =
        typeof payload.code === 'string'
          ? payload.code.trim().toUpperCase()
          : '';

      if (!code) {
        return new Response(
          JSON.stringify({ error: 'Coupon code is required' }),
          {
            status: 400,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            },
          }
        );
      }

      const { data: coupon, error: fetchError } = await supabase
        .from('coupons')
        .select('show_on_offers_page')
        .eq('code', code)
        .maybeSingle();

      if (fetchError) throw fetchError;

      if (!coupon) {
        return new Response(
          JSON.stringify({ error: 'Coupon not found' }),
          {
            status: 404,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            },
          }
        );
      }

      const current = Boolean(coupon.show_on_offers_page);

      const { error } = await supabase
        .from('coupons')
        .update({ show_on_offers_page: !current })
        .eq('code', code);

      if (error) throw error;

      return new Response(
        JSON.stringify({
          success: true,
          show_on_offers_page: !current,
        }),
        {
          status: 200,
          headers: {
            'Content-Type': 'application/json',
            ...getCORSHeaders(env, request),
          },
        }
      );
    }

    if (payload.action === 'validate') {
      const code =
        typeof payload.code === 'string'
          ? payload.code.trim().toUpperCase()
          : '';

      if (!code) {
        return new Response(
          JSON.stringify({ error: 'Coupon code is required' }),
          {
            status: 400,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            },
          }
        );
      }

      const { data: coupon, error } = await supabase
        .from('coupons')
        .select('*')
        .eq('code', code)
        .eq('active', true)
        .maybeSingle();

      if (error || !coupon) {
        return new Response(
          JSON.stringify({ error: 'Invalid coupon' }),
          {
            status: 400,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            },
          }
        );
      }

      // SECURITY: Calculate actual subtotal from cart items, not trust client
      const { items } = payload;

      if (!items || items.length === 0) {
        return new Response(
          JSON.stringify({ error: 'Cart items required for validation' }),
          {
            status: 400,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            },
          }
        );
      }

      // Fetch real prices from database
      const productIds = items.map(item => item.product_id);
      const { data: products, error: productsError } = await supabase
        .from('products')
        .select('id, regular_price, sale_price')
        .in('id', productIds);

      if (productsError) throw productsError;

      // Calculate actual subtotal
      let actualSubtotal = 0;
      items.forEach(item => {
        const product = products.find(p => p.id === item.product_id);
        if (product) {
          const price = product.sale_price || product.regular_price || 0;
          actualSubtotal += price * (item.quantity || 1);
        }
      });

      // Apply coupon to actual subtotal
      let discountAmount = 0;
      if (coupon.type === 'percent') {
        discountAmount = Math.min(
          actualSubtotal,
          actualSubtotal * (Number(coupon.value) / 100)
        );
      } else if (coupon.type === 'flat') {
        discountAmount = Math.min(actualSubtotal, Number(coupon.value));
      }

      return new Response(
        JSON.stringify({
          code: coupon.code,
          discountAmount,
          subtotal: actualSubtotal,
          finalAmount: actualSubtotal - discountAmount,
          message:
            coupon.type === 'percent'
              ? `Applied ${coupon.value}% OFF`
              : `₹${coupon.value} OFF`,
        }),
        {
          status: 200,
          headers: {
            'Content-Type': 'application/json',
            ...getCORSHeaders(env, request),
          },
        }
      );
    }

    return new Response(
      JSON.stringify({ error: 'Invalid action' }),
      {
        status: 400,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      }
    );
  } catch (error) {
    const message =
      error && typeof error === 'object' && 'message' in error
        ? String(error.message)
        : 'Unexpected error';

    return new Response(JSON.stringify({ error: message }), {
      status: 500,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(env, request),
      },
    });
  }
}

// Route handler for lead-analytics
async function handleLeadAnalytics(request, env) {
