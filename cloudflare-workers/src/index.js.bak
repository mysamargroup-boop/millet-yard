async function handleSiteSettings(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  if (request.method !== 'POST') {
    return new Response(
      JSON.stringify({ error: 'Method not allowed' }),
      {
        status: 405,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      }
    );
  }

  try {
    const payload = await request.json();
    const supabase = createSupabaseAdmin(env);

    if (payload.action === 'get') {
      const { data, error } = await supabase
        .from('site_settings')
        .select('*')
        .maybeSingle();

      if (error) throw error;

      return new Response(JSON.stringify(data || {}), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    if (payload.action === 'update') {
      const { data, error } = await supabase
        .from('site_settings')
        .upsert(payload.data, { onConflict: 'id' })
        .select()
        .maybeSingle();

      if (error) throw error;

      return new Response(JSON.stringify(data || {}), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    return new Response(
      JSON.stringify({ error: 'Invalid action' }),
      {
        status: 400,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      },
    );
  } catch (error) {
    const message =
      error && typeof error === 'object' && 'message' in error
        ? String(error.message)
        : 'Unexpected error';

    return new Response(JSON.stringify({ error: message }), {
      status: 500,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(env, request),
      },
    });
  }
}

// Route handler for products
async function handleProducts(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  try {
    const supabase = createSupabaseAdmin(env);

    if (request.method === 'GET') {
      const { data, error } = await supabase
        .from('products')
        .select('*')
        .not('id', 'is', null)
        .order('created_at', { ascending: false });

      if (error) throw error;

      // Transform snake_case to camelCase for frontend compatibility
      const transformedData = (data || []).map(product => ({
        ...product,
        imageUrl: product.image_url || null,
        imageAlt: product.image_alt || product.name,
        imageHint: product.image_hint || '',
        regularPrice: product.regular_price || product.price || 0,
        salePrice: product.sale_price || null,
        shortDescription: product.short_description || '',
        specificDescription: product.specific_description || '',
        galleryImages: product.gallery_images || [],
        reviewCount: product.review_count || 0,
        createdAt: product.created_at,
        updatedAt: product.updated_at,
      }));

      return new Response(JSON.stringify(transformedData), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    if (request.method === 'POST') {
      const payload = await request.json();
      const insertData = { ...payload.data };

      if (
        (insertData.price === undefined || insertData.price === null) &&
        insertData.regular_price != null
      ) {
        insertData.price = insertData.regular_price;
      }

      const { data, error } = await supabase
        .from('products')
        .insert(insertData)
        .select()
        .maybeSingle();

      if (error) throw error;

      return new Response(JSON.stringify(data || null), {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      });
    }

    return new Response(
      JSON.stringify({ error: 'Method not allowed' }),
      {
        status: 405,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      },
    );
  } catch (error) {
    const message =
      error && typeof error === 'object' && 'message' in error
        ? String(error.message)
        : 'Unexpected error';

    return new Response(JSON.stringify({ error: message }), {
      status: 500,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(env, request),
      },
    });
  }
}

