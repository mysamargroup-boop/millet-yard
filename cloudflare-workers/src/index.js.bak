// Route handler for send-whatsapp
async function handleSendWhatsApp(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  if (request.method !== 'POST') {
    return new Response(
      JSON.stringify({ error: 'Method not allowed' }),
      {
        status: 405,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      }
    );
  }

  try {
    const payload = await request.json();

    const to =
      payload.to ||
      payload.phone ||
      payload.recipient ||
      payload.data?.to ||
      null;
    const body =
      payload.body ||
      payload.message ||
      payload.text ||
      payload.data?.message ||
      null;
    const previewUrl =
      typeof payload.previewUrl === 'boolean'
        ? payload.previewUrl
        : Boolean(payload.data?.previewUrl);

    if (!to || !body) {
      return new Response(
        JSON.stringify({ error: 'Missing to or message/body field' }),
        {
          status: 400,
          headers: {
            'Content-Type': 'application/json',
            ...getCORSHeaders(env, request),
          },
        }
      );
    }

    const result = await sendWhatsAppTextMessage(env, {
      to: String(to),
      body: String(body),
      previewUrl,
    });

    return new Response(JSON.stringify({ success: true, result }), {
      status: 200,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(env, request),
      },
    });
  } catch (error) {
    const message =
      error && typeof error === 'object' && 'message' in error
        ? String(error.message)
        : 'Unexpected error';

    return new Response(JSON.stringify({ error: message }), {
      status: 500,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(env, request),
      },
    });
  }
}

// Route handler for shiprocket-webhook
async function handleShiprocketWebhook(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  if (request.method !== 'POST') {
    return new Response(
      JSON.stringify({ error: 'Method not allowed' }),
      {
        status: 405,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      }
    );
  }

  try {
    const payload = await request.json();
    const supabase = createSupabaseAdmin(env);

    const possibleOrderId =
      payload?.order_id ||
      payload?.orderId ||
      payload?.reference_number ||
      payload?.order?.order_id ||
      payload?.shipment?.order_id ||
      null;

    if (!possibleOrderId) {
      return new Response(
        JSON.stringify({
          received: true,
          warning: 'Missing order identifier in payload',
        }),
        {
          status: 200,
          headers: {
            'Content-Type': 'application/json',
            ...getCORSHeaders(env, request),
          },
        }
      );
    }

    const { data: existingOrder } = await supabase
      .from('orders')
      .select('*')
      .eq('external_order_id', String(possibleOrderId))
      .maybeSingle();

    const statusText =
      payload?.current_status ||
      payload?.status ||
      payload?.shipment_status ||
      'SHIPPING_UPDATE';
    const awb =
      payload?.awb_code || payload?.awb || payload?.shipment?.awb || null;
    const courier =
      payload?.courier_name ||
      payload?.courier ||
      payload?.shipment?.courier ||
      null;

    const noteParts = [];
    noteParts.push(`Shiprocket: ${statusText}`);
    if (awb) noteParts.push(`AWB: ${awb}`);
    if (courier) noteParts.push(`Courier: ${courier}`);

    if (existingOrder) {
      const validClientKeys = [
        env?.PUBLIC_CLIENT_KEY,
        'nemaone-2026', // Fallback for development
      ].filter(Boolean);

      const combinedNote = [
        existingOrder.admin_notes,
        noteParts.join(' | '),
      ]
        .filter(Boolean)
        .join('\n');

      await supabase
        .from('orders')
        .update({
          admin_notes: combinedNote,
          updated_at: new Date().toISOString(),
        })
        .eq('id', existingOrder.id);

      await supabase.from('order_status_history').insert({
        order_id: existingOrder.id,
        old_status: existingOrder.status,
        new_status: existingOrder.status,
        reason: 'Shiprocket webhook',
        admin_note: noteParts.join(' | '),
        created_by: 'shiprocket',
        created_at: new Date().toISOString(),
      });
    }

    return new Response(JSON.stringify({ success: true }), {
      status: 200,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(env, request),
      },
    });
  } catch (error) {
    const message =
      error && typeof error === 'object' && 'message' in error
        ? String(error.message)
        : 'Unexpected error';

    return new Response(JSON.stringify({ error: message }), {
      status: 500,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(env, request),
      },
    });
  }
}

// Route handler for payment-webhook
async function handlePaymentWebhook(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  if (request.method !== 'POST') {
    return new Response(
      JSON.stringify({ error: 'Method not allowed' }),
      {
        status: 405,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      }
    );
  }

  try {
    const payload = await request.json();
    const supabase = createSupabaseAdmin(env);

    // Payment webhook processing logic
    const { data, error } = await supabase
      .from('payment_webhooks')
      .insert({
        webhook_data: payload,
        created_at: new Date().toISOString(),
      })
      .select()
      .maybeSingle();

    if (error) throw error;

    return new Response(JSON.stringify({ success: true, data }), {
      status: 200,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(env, request),
      },
    });
  } catch (error) {
    const message =
      error && typeof error === 'object' && 'message' in error
        ? String(error.message)
        : 'Unexpected error';

    return new Response(JSON.stringify({ error: message }), {
      status: 500,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(env, request),
      },
    });
  }
}

// Route handler for whatsapp-send-template
async function handleWhatsAppSendTemplate(request, env) {
  if (request.method === 'OPTIONS') {
    return new Response('ok', { headers: getCORSHeaders(env, request) });
  }

  if (request.method !== 'POST') {
    return new Response(
      JSON.stringify({ error: 'Method not allowed' }),
      {
        status: 405,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      }
    );
  }

  try {
    const payload = await request.json();
    const supabase = createSupabaseAdmin(env);

    // WhatsApp template sending logic
    const { data, error } = await supabase
      .from('whatsapp_templates')
      .insert(payload.data)
      .select()
      .maybeSingle();

    if (error) throw error;

    return new Response(JSON.stringify(data || null), {
      status: 200,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(env, request),
      },
    });
  } catch (error) {
    const message =
      error && typeof error === 'object' && 'message' in error
        ? String(error.message)
        : 'Unexpected error';

    return new Response(JSON.stringify({ error: message }), {
      status: 500,
      headers: {
        'Content-Type': 'application/json',
        ...getCORSHeaders(env, request),
      },
    });
  }
}

// Rate limiting using Cloudflare KV
async function checkRateLimit(request, env) {
  const ip = request.headers.get('CF-Connecting-IP') || 'unknown';
  const hourKey = `ratelimit:${ip}:${new Date().getHours()}`;

  const count = await env.KV?.get(hourKey);
  const limit = 100; // 100 requests per hour per IP

  if (count && parseInt(count) >= limit) {
    return { allowed: false, remaining: 0, resetTime: (60 - new Date().getMinutes()) * 60 };
  }

  const newCount = count ? parseInt(count) + 1 : 1;
  await env.KV?.put(hourKey, String(newCount), { expirationTtl: 3600 });

  return { allowed: true, remaining: limit - newCount };
}

// Input validation helper
function validateOrderInput(data) {
  const errors = [];

  if (!data.orderId) errors.push('orderId is required');
  if (!data.amount || data.amount <= 0) errors.push('Invalid amount');
  if (!data.customerPhone) errors.push('customerPhone is required');
  if (!data.items || data.items.length === 0) errors.push('items are required');

  if (errors.length > 0) {
    throw new Error(errors.join(', '));
  }
}

// Error logging helper
function logError(context, error, request) {
  console.error(JSON.stringify({
    timestamp: new Date().toISOString(),
    context,
    error: error.message,
    stack: error.stack,
    request: {
      method: request.method,
      url: request.url,
      ip: request.headers.get('CF-Connecting-IP'),
      userAgent: request.headers.get('User-Agent')
    }
  }));
}

// Simple auth check - only for admin endpoints
function checkAdminAuth(request, env) {
  const apiKey = request.headers.get('X-API-Key');
  const validApiKey = env?.API_KEY || env?.API_LOG_KEY;

  if (!apiKey || !validApiKey || apiKey !== validApiKey) {
    return { valid: false, error: 'Admin API key required' };
  }

  return { valid: true };
}

export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    const path = url.pathname;

    if (request.method === 'OPTIONS') {
      return new Response('ok', { headers: getCORSHeaders(env, request) });
    }

    // Simple auth logic
    // 1. Admin endpoints require API key
    if (path.includes('-admin')) {
      const auth = checkAdminAuth(request, env);
      if (!auth.valid) {
        return new Response(
          JSON.stringify({ error: auth.error }),
          {
            status: 401,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            }
          }
        );
      }
    }

    // 2. Rate limiting for non-GET requests
    if (request.method !== 'GET') {
      const rateLimit = await checkRateLimit(request, env);
      if (!rateLimit.allowed) {
        return new Response(
          JSON.stringify({
            error: 'Rate limit exceeded',
            resetTime: rateLimit.resetTime
          }),
          {
            status: 429,
            headers: {
              'Content-Type': 'application/json',
              ...getCORSHeaders(env, request),
            }
          }
        );
      }
    }

    if (path.startsWith('/__debug')) {
      if (env?.ENVIRONMENT === 'production') {
        return new Response(JSON.stringify({ error: 'Route not found' }), {
          status: 404,
          headers: {
            'Content-Type': 'application/json',
            ...getCORSHeaders(env, request),
          },
        });
      }
      return new Response(
        JSON.stringify(
          {
            environment: env?.ENVIRONMENT,
            envKeys: Object.keys(env || {}),
            has: {
              SUPABASE_URL: Boolean(env?.SUPABASE_URL),
              SUPABASE_SERVICE_ROLE_KEY: Boolean(env?.SUPABASE_SERVICE_ROLE_KEY),
              ALLOWED_ORIGIN: Boolean(env?.ALLOWED_ORIGIN),
              PUBLIC_URL: Boolean(env?.PUBLIC_URL),
              API_LOG_KEY: Boolean(env?.API_LOG_KEY),
              API_KEY: Boolean(env?.API_KEY),
              CF_ACCESS_CLIENT_ID: Boolean(env?.CF_ACCESS_CLIENT_ID),
              CF_ACCESS_CLIENT_SECRET: Boolean(env?.CF_ACCESS_CLIENT_SECRET),
            },
            processEnvHas: {
              SUPABASE_URL: Boolean(globalThis?.process?.env?.SUPABASE_URL),
              SUPABASE_SERVICE_ROLE_KEY: Boolean(globalThis?.process?.env?.SUPABASE_SERVICE_ROLE_KEY),
              ALLOWED_ORIGIN: Boolean(globalThis?.process?.env?.ALLOWED_ORIGIN),
              PUBLIC_URL: Boolean(globalThis?.process?.env?.PUBLIC_URL),
              API_LOG_KEY: Boolean(globalThis?.process?.env?.API_LOG_KEY),
              API_KEY: Boolean(globalThis?.process?.env?.API_KEY),
              CF_ACCESS_CLIENT_ID: Boolean(globalThis?.process?.env?.CF_ACCESS_CLIENT_ID),
              CF_ACCESS_CLIENT_SECRET: Boolean(globalThis?.process?.env?.CF_ACCESS_CLIENT_SECRET),
            },
            request: {
              origin: request.headers.get('Origin'),
              host: request.headers.get('Host'),
            },
            cors: {
              allowOrigin: getCORSHeaders(env, request)['Access-Control-Allow-Origin'],
            },
          },
          null,
          2
        ),
        {
          status: 200,
          headers: {
            'Content-Type': 'application/json',
            ...getCORSHeaders(env, request),
          },
        }
      );
    }

    if (env?.ENVIRONMENT !== 'production') {
      console.log('🔍 Request received:', {
        method: request.method,
        url: request.url,
        path: path,
        environment: env?.ENVIRONMENT,
      });
    }

    // Route to appropriate handler
    if (path.startsWith('/cashfree-webhook')) {
      return handleCashfreeWebhook(request, env);
    } else if (path.startsWith('/categories')) {
      return handleCategories(request, env);
    } else if (path.startsWith('/create-order')) {
      return handleCreateOrder(request, env);
    } else if (path.startsWith('/create-payment')) {
      return handleCreatePayment(request, env);
    } else if (path.startsWith('/orders-admin')) {
      return handleOrdersAdmin(request, env);
    } else if (path.startsWith('/products-admin')) {
      return handleProductsAdmin(request, env);
    } else if (path.startsWith('/coupons-admin')) {
      return handleCouponsAdmin(request, env);
    } else if (path.startsWith('/lead-analytics')) {
      return handleLeadAnalytics(request, env);
    } else if (path.startsWith('/order-status')) {
      return handleOrderStatus(request, env);
    } else if (path.startsWith('/site-settings-admin') || path.startsWith('/site-settings')) {
      return handleSiteSettings(request, env);
    } else if (path.startsWith('/products')) {
      return handleProducts(request, env);
    } else if (path.startsWith('/subscriptions')) {
      return handleSubscriptions(request, env);
    } else if (path.startsWith('/send-whatsapp')) {
      return handleSendWhatsApp(request, env);
    } else if (path.startsWith('/shiprocket-webhook')) {
      return handleShiprocketWebhook(request, env);
    } else if (path.startsWith('/payment-webhook')) {
      return handlePaymentWebhook(request, env);
    } else if (path.startsWith('/whatsapp-send-template')) {
      return handleWhatsAppSendTemplate(request, env);
    } else if (path.startsWith('/reviews')) {
      return handleReviews(request, env);
    } else if (path.startsWith('/site-images')) {
      return handleSiteImages(request, env);
    } else if (path.startsWith('/sliding-cards')) {
      return handleSlidingCards(request, env);
    } else if (path.startsWith('/customer/update-profile')) {
      return handleCustomerUpdateProfile(request, env);
    } else if (path.startsWith('/customer/update-address')) {
      return handleCustomerUpdateAddress(request, env);
    } else if (path.startsWith('/customer/get')) {
      return handleGetCustomer(request, env);
    }
    if (path.startsWith('/auth/request-otp')) {
      return handleAuthRequestOTP(request, env);
    } else if (path.startsWith('/auth/verify-otp')) {
      return handleAuthVerifyOTP(request, env);
    }

    // Default response for unknown routes
    return new Response(
      JSON.stringify({ error: 'Route not found' }),
      {
        status: 404,
        headers: {
          'Content-Type': 'application/json',
          ...getCORSHeaders(env, request),
        },
      }
    );
  },
};

// Helper function to send WhatsApp template (for cron job)
async function sendWhatsAppTemplate(env, phone, templateName, variables) {
  const accessToken = env.WHATSAPP_CLOUD_ACCESS_TOKEN;
  const phoneNumberId = env.WHATSAPP_CLOUD_PHONE_NUMBER_ID;
  const apiVersion = env.WHATSAPP_API_VERSION || 'v20.0';

  if (!accessToken || !phoneNumberId) {
    throw new Error('WhatsApp credentials not configured');
  }

  const bodyParams = Object.values(variables).map(value => ({
    type: 'text',
    text: String(value)
  }));

  const response = await fetch(
    `https://graph.facebook.com/${apiVersion}/${phoneNumberId}/messages`,
    {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${accessToken}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        messaging_product: 'whatsapp',
        to: phone,
        type: 'template',
        template: {
          name: templateName,
          language: { code: 'en' },
          components: [{
            type: 'body',
            parameters: bodyParams
          }]
        }
      }),
    }
  );

  if (!response.ok) {
    const error = await response.text();
    throw new Error(`WhatsApp API error: ${error}`);
  }

  return response.json();
}
