{
  "name": "shop-api-cloudflare",
  "version": "1.0.0",
  "description": "Cloudflare Workers for Shop API",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "node deploy.js",
    "deploy:staging": "node deploy.js staging",
    "deploy:production": "node deploy.js production",
    "deploy:direct": "wrangler deploy",
    "test": "node test-worker.js",
    "test:local": "WORKER_URL=http://localhost:8787 node test-worker.js",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "wrangler": "^4.59.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0"
  }
}
